{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickup-runner",
  "compatibility_date": "2026-09-04",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "src",
      "public",
      "scripts",
      "index.html",
      "vite.config.ts",
      "tailwind.config.cjs",
      "postcss.config.cjs"
    ]
  }
}
